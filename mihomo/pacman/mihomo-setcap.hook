[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = mihomo
Target = mihomo-bin

[Action]
Description = Restore TUN capabilities on mihomo (lost when the binary is replaced)
When = PostTransaction
Exec = /usr/bin/setcap cap_net_admin,cap_net_raw,cap_net_bind_service=+ep /usr/bin/mihomo
