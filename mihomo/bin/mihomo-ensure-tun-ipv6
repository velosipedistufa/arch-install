#!/usr/bin/env bash
# Ensure mihomo TUN has dual-stack addresses in the on-disk config.
# mihomo-tui / PATCH /configs often returns tun without inet6-address; a later
# Restart then runs without IPv6 redirect until the YAML is re-applied.
set -euo pipefail

CONFIG="${MIHOMO_CONFIG:-$HOME/.config/mihomo/config.yaml}"
INET4="${MIHOMO_TUN_INET4:-198.18.0.1/30}"
INET6="${MIHOMO_TUN_INET6:-fdfe:dcba:9876::1/126}"

if [[ ! -f "$CONFIG" ]]; then
  echo "mihomo-ensure-tun-ipv6: missing $CONFIG" >&2
  exit 0
fi

python3 - "$CONFIG" "$INET4" "$INET6" <<'PY'
import sys
from pathlib import Path

path = Path(sys.argv[1])
inet4, inet6 = sys.argv[2], sys.argv[3]
text = path.read_text()
lines = text.splitlines(True)
out = []
in_tun = False
tun_indent = ""
have_inet4 = False
have_inet6 = False
inserted = False

def is_top_level(raw: str) -> bool:
    s = raw.strip()
    if not s or s.startswith("#"):
        return False
    return not raw.startswith((" ", "\t")) and ":" in s

i = 0
while i < len(lines):
    raw = lines[i]
    stripped = raw.strip()

    if is_top_level(raw):
        if in_tun and not inserted:
            # Leaving tun block — inject any missing address keys before exit
            ind = tun_indent + "  "
            if not have_inet4:
                out.append(f"{ind}inet4-address:\n{ind}  - {inet4}\n")
            if not have_inet6:
                out.append(f"{ind}inet6-address:\n{ind}  - {inet6}\n")
            inserted = True
        in_tun = stripped == "tun:" or stripped.startswith("tun:")
        if in_tun:
            tun_indent = raw[: len(raw) - len(raw.lstrip())]
            have_inet4 = False
            have_inet6 = False
            inserted = False
        out.append(raw)
        i += 1
        continue

    if in_tun:
        if stripped.startswith("inet4-address:"):
            have_inet4 = True
            out.append(raw)
            i += 1
            # skip existing list items; rewrite single desired value
            while i < len(lines) and (lines[i].startswith(" ") or lines[i].startswith("\t")) and lines[i].strip().startswith("-"):
                i += 1
            ind = tun_indent + "  "
            out.append(f"{ind}  - {inet4}\n")
            continue
        if stripped.startswith("inet6-address:"):
            have_inet6 = True
            out.append(raw)
            i += 1
            while i < len(lines) and (lines[i].startswith(" ") or lines[i].startswith("\t")) and lines[i].strip().startswith("-"):
                i += 1
            ind = tun_indent + "  "
            out.append(f"{ind}  - {inet6}\n")
            continue

    out.append(raw)
    i += 1

if in_tun and not inserted:
    ind = tun_indent + "  "
    if not have_inet4:
        out.append(f"{ind}inet4-address:\n{ind}  - {inet4}\n")
    if not have_inet6:
        out.append(f"{ind}inet6-address:\n{ind}  - {inet6}\n")

new = "".join(out)
if new != text:
    path.write_text(new)
    print(f"mihomo-ensure-tun-ipv6: updated {path} (inet4={inet4}, inet6={inet6})")
else:
    print(f"mihomo-ensure-tun-ipv6: ok {path}")
PY
